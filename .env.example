# Optional: override the dedicated test database used by `mvnw test`.
SAIDIKA_TEST_DB_URL=jdbc:postgresql://localhost:5432/saidika_test
SAIDIKA_TEST_DB_USERNAME=saidika
SAIDIKA_TEST_DB_PASSWORD=saidika_dev

# Spring AI / Ollama (agent/tool-calling not yet implemented).
SAIDIKA_OLLAMA_BASE_URL=http://localhost:11434
SAIDIKA_OLLAMA_MODEL=qwen3:4b
