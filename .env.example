# Copy to .env (or export in your shell) and adjust for your local PostgreSQL setup.
# Never commit real credentials.

SAIDIKA_DB_URL=jdbc:postgresql://localhost:5432/saidika
SAIDIKA_DB_USERNAME=saidika
